{
  "name": "floating-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Lightweight always-on-top Windows desktop AI assistant with BYOK providers and screen capture.",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "npm run build:electron && concurrently -k \"vite --port=3000 --host=127.0.0.1\" \"wait-on http://127.0.0.1:3000 && ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron .\"",
    "build": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --config electron-builder.yml",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "dotenv": "^17.2.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "express": "^4.21.2",
    "groq-sdk": "^1.6.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
